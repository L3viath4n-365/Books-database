<% const books=typeof book !=='undefined' ? book : {}; %>

    <section class="max-w-2xl mx-auto px-4 py-8">
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Edit Book</h1>
            <a href="/books"
                class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition-colors duration-200">
                ← Back to Books
            </a>
        </div>

        <form action="/books/<%= books.id %>?_method=PUT" method="POST"
            class="bg-white shadow-md rounded-lg p-6 md:p-8 space-y-6">
            <div>
                <label for="title" class="block text-sm font-semibold text-gray-700 mb-2">
                    Title <span class="text-red-500">*</span>
                </label>
                <input type="text" id="title" name="title"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors duration-200"
                    value="<%= books.title || '' %>" placeholder="Enter book title" required>
            </div>

            <div>
                <label for="author" class="block text-sm font-semibold text-gray-700 mb-2">
                    Author <span class="text-red-500">*</span>
                </label>
                <input type="text" id="author" name="author"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors duration-200"
                    value="<%= books.author || '' %>" placeholder="Enter author name" required>
            </div>

            <div>
                <label for="rating" class="block text-sm font-semibold text-gray-700 mb-2">Rating</label>
                <select id="rating" name="rating"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors duration-200 bg-white">
                    <option value="">Select rating</option>
                    <option value="1" <%=books.rating==1 ? 'selected' : '' %>>1 - Poor</option>
                    <option value="2" <%=books.rating==2 ? 'selected' : '' %>>2 - Fair</option>
                    <option value="3" <%=books.rating==3 ? 'selected' : '' %>>3 - Good</option>
                    <option value="4" <%=books.rating==4 ? 'selected' : '' %>>4 - Very Good</option>
                    <option value="5" <%=books.rating==5 ? 'selected' : '' %>>5 - Excellent</option>
                </select>
            </div>

            <div>
                <label for="status" class="block text-sm font-semibold text-gray-700 mb-2">
                    Status <span class="text-red-500">*</span>
                </label>
                <select id="status" name="status"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors duration-200 bg-white"
                    required>
                    <option value="">Select status</option>
                    <option value="Read" <%=books.status==='Read' ? 'selected' : '' %>>Read</option>
                    <option value="To Read" <%=books.status==='To Read' ? 'selected' : '' %>>To Read</option>
                    <option value="Currently Reading" <%=books.status==='Currently Reading' ? 'selected' : '' %>
                        >Currently Reading</option>
                    <option value="Want to Read" <%=books.status==='Want to Read' ? 'selected' : '' %>>Want to Read
                    </option>
                </select>
            </div>

            <div>
                <label for="notes" class="block text-sm font-semibold text-gray-700 mb-2">Notes</label>
                <textarea id="notes" name="notes" rows="6"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors duration-200 resize-y"
                    placeholder="Add your thoughts, key takeaways, or memorable quotes..."><%= books.notes || '' %></textarea>
            </div>

            <div class="flex items-center gap-4 pt-4">
                <button type="submit"
                    class="inline-flex items-center px-6 py-2.5 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors duration-200">
                    Update Book
                </button>
                <a href="/books"
                    class="inline-flex items-center px-6 py-2.5 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition-colors duration-200">
                    Cancel
                </a>
            </div>
        </form>
    </section>